---
import { GlassButton, NavCheckbox } from "@/components/integrations";
import { Icon } from "@/components/shared/Utils";
import "./Header.sass";

const currentPath = Astro.url.pathname.replace(/\//g, '');
---
<header>
	<NavCheckbox />
	<GlassButton as="a" href="/" className={ currentPath === '' ? 'active' : undefined } client:load>
		<p>
			<span>Home</span>
		</p>
		<Icon type="home" />
	</GlassButton>
	<GlassButton as="a" href="/archives/" className={ currentPath === 'archives' ? 'active' : undefined } client:load>
		<p>
			<span>Archives</span>
		</p>
		<Icon type="folder" />
	</GlassButton>
	<GlassButton as="a" href="/types/" className={ currentPath === 'types' ? 'active' : undefined } client:load>
		<p>
			<span>Types</span>
		</p>
		<Icon type="code" />
	</GlassButton>
	<GlassButton as="div" id="btn_nav" client:load>
		<span></span>
	</GlassButton>
</header>
