---
import { buildMeta } from "@/_global/lib/meta";
import { Footer, Header, Nav } from "@/components/shared/Sections";
import { Bg } from "../integrations";
import { MetaTags } from "../shared/Utils";
import type { YamlFiles, MetaProps } from "@/_global/lib/meta";
import type { DeepGuard } from "@/_global/types/types";
import "@/_global/styles/global.sass";

const globData = import.meta.glob('./**/_data/meta.yaml', { eager: true }) as YamlFiles;
const pageData = import.meta.glob('./**/Page.astro', { eager: true });

const props: DeepGuard<MetaProps> = Astro.props;
const meta = buildMeta({ ...props, globData, pageData });
---
<!doctype html>
<html lang="ja">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" href="/favicon.png" />
		<link rel="apple-touch-icon" href="/favicon.png" />
		<link rel="stylesheet" href="https://use.fontawesome.com/releases/v6.2.0/css/all.css" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="" />
		<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=M+PLUS+2:wght@400&display=swap" />
		<MetaTags { ...meta } />
	</head>
	<body>
		<Header />
		<slot />
		<Nav />
		<Footer />
		<Bg client:load />
	</body>
</html>
